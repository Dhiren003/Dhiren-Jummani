{% doc %}
  @prompt
    Create a responsive fashion homepage block named 'Loomhaus Editorial Homepage', matching this reference description closely. Warm ivory background (
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .loomhaus-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: clamp(28px, 5vw, 76px);
    box-sizing: border-box;
  }

  .loomhaus-editorial__layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(28px, 6vw, 88px);
    max-width: 1440px;
    margin: 0 auto;
  }

  .loomhaus-editorial__copy-{{ ai_gen_id }} {
    padding: clamp(0px, 2vw, 28px) 0;
  }

  .loomhaus-editorial__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 22px;
    color: {{ block.settings.text_color }};
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .loomhaus-editorial__heading-{{ ai_gen_id }} {
    max-width: 620px;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(44px, 6.7vw, {{ block.settings.heading_size }}px);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .loomhaus-editorial__description-{{ ai_gen_id }} {
    max-width: 390px;
    margin: 24px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.7;
  }

  .loomhaus-editorial__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 30px;
    padding: 0 24px;
    border: 1px solid {{ block.settings.text_color }};
    background: {{ block.settings.text_color }};
    color: {{ block.settings.background_color }};
    font-size: 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .loomhaus-editorial__link-{{ ai_gen_id }}:hover {
    background: transparent;
    color: {{ block.settings.text_color }};
  }

  .loomhaus-editorial__link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  .loomhaus-editorial__media-{{ ai_gen_id }} {
    position: relative;
    min-height: 340px;
    aspect-ratio: 0.88;
    overflow: hidden;
    background: #e8e1d7;
  }

  .loomhaus-editorial__media-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .loomhaus-editorial__placeholder-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 340px;
    align-items: center;
    justify-content: center;
    background: #e8e1d7;
    position: relative;
  }

  .loomhaus-editorial__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-height: 700px;
    object-fit: cover;
    color: #8f877d;
  }

  .loomhaus-editorial__empty-{{ ai_gen_id }} {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    margin: 0;
    padding: 10px 12px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-size: 12px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .loomhaus-editorial-{{ ai_gen_id }} {
      padding: 28px 20px 36px;
    }

    .loomhaus-editorial__layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .loomhaus-editorial__copy-{{ ai_gen_id }} {
      order: 1;
      padding: 0;
    }

    .loomhaus-editorial__media-{{ ai_gen_id }} {
      order: 2;
      min-height: 260px;
      aspect-ratio: 0.95;
    }

    .loomhaus-editorial__placeholder-{{ ai_gen_id }} {
      min-height: 260px;
    }

    .loomhaus-editorial__heading-{{ ai_gen_id }} {
      font-size: clamp(42px, 13vw, 68px);
    }
  }
{% endstyle %}

<section class="loomhaus-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="loomhaus-editorial__layout-{{ ai_gen_id }}">
    <div class="loomhaus-editorial__copy-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="loomhaus-editorial__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h1 class="loomhaus-editorial__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape | newline_to_br }}</h1>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="loomhaus-editorial__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="loomhaus-editorial__link-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
    <div class="loomhaus-editorial__media-{{ ai_gen_id }}">
      {% if block.settings.hero_image != blank %}
        <img src="{{ block.settings.hero_image | image_url: width: 1800 }}" alt="{{ block.settings.hero_image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.hero_image.width }}" height="{{ block.settings.hero_image.height }}">
      {% else %}
        <div class="loomhaus-editorial__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <p class="loomhaus-editorial__empty-{{ ai_gen_id }}">Add an editorial fashion image to complete this feature.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Loomhaus editorial",
  "settings": [
    {
      "type": "header",
      "content": "Editorial content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE NEW SEASON"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Quiet pieces.\nLasting presence."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Considered essentials for the way you move through every day. Discover thoughtful fabrics, effortless shapes, and a softer approach to getting dressed.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Editorial image"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Maximum headline size",
      "min": 48,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#28251F"
    }
  ],
  "presets": [
    {
      "name": "Loomhaus editorial"
    }
  ],
  "tag": null,
  "class": "loomhaus-editorial-block"
}
{% endschema %}