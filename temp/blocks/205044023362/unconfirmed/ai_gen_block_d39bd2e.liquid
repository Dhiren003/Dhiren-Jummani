{% doc %}
  @prompt
    Create a self-contained configurable header block named 'Loomhaus Custom Header' to replace, not supplement, an existing header. Desktop single horizontal row on warm ivory #F7F5ED with charcoal #292A26: left editable logo image with editable width and fallback text 'Loomhaus'; tagline centered vertically and horizontally reading 'Clothes made to be worn for years, not seasons.'; right outlined pill button 'SHOP THE DROP' followed by working cart/bag link with actual cart count. Provide settings for tagline text and visibility, button label, button URL and visibility, logo image/width/fallback text, background and text colors, button border color, content max width and horizontal/vertical padding. Show button only with a valid chosen destination. No search or profile icons. Use a balanced three-column layout so tagline stays centered in the header, not above it; do not position tagline at top of page. Preserve accessibility and keyboard focus. Mobile layout must keep logo, button and cart usable without overflow; hide tagline on mobile, reduce button size, and include an accessible navigation menu using a merchant-selected menu if possible. Logo links to home and cart links to cart. Do not disable accounts globally. Scope all styles to this instance. This is a reusable theme block with its own grouped editable settings, not instructions to paste markup into an existing header. Existing theme header must be hidden or removed separately by the merchant to avoid duplication; do not automatically modify or remove it. Leave announcement bar untouched. These should be under Header
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-loomhaus-header-{{ ai_gen_id }}{display:block;width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};padding:{{ block.settings.vertical_padding }}px 0}.ai-loomhaus-header-{{ ai_gen_id }} *{box-sizing:border-box}.ai-loomhaus-header__inner-{{ ai_gen_id }}{width:min({{ block.settings.content_max_width }}px,calc(100% - {{ block.settings.horizontal_padding | times: 2 }}px));margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr) minmax(0,1fr);align-items:center;gap:20px}.ai-loomhaus-header__brand-{{ ai_gen_id }}{justify-self:start;display:inline-flex;align-items:center;color:inherit;text-decoration:none}.ai-loomhaus-header__logo-{{ ai_gen_id }}{display:block;width:{{ block.settings.logo_width }}px;max-width:100%;height:auto}.ai-loomhaus-header__fallback-{{ ai_gen_id }}{color:inherit;font-size:24px;line-height:1;letter-spacing:.02em}.ai-loomhaus-header__tagline-{{ ai_gen_id }}{margin:0;text-align:center;font-size:14px;line-height:1.4}.ai-loomhaus-header__actions-{{ ai_gen_id }}{justify-self:end;display:flex;align-items:center;justify-content:flex-end;gap:16px;min-width:0}.ai-loomhaus-header__shop-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 18px;border:1px solid {{ block.settings.button_border_color }};border-radius:999px;color:inherit;background:transparent;text-decoration:none;font-size:11px;letter-spacing:.08em;white-space:nowrap}.ai-loomhaus-header-{{ ai_gen_id }} a:focus-visible,.ai-loomhaus-header-{{ ai_gen_id }} button:focus-visible{outline:2px solid currentColor;outline-offset:4px}.ai-loomhaus-header__cart-{{ ai_gen_id }}{display:inline-flex;align-items:center;gap:6px;color:inherit;text-decoration:none;white-space:nowrap}.ai-loomhaus-header__cart-{{ ai_gen_id }} svg{width:23px;height:23px;flex:0 0 auto}.ai-loomhaus-header__count-{{ ai_gen_id }}{font-size:12px}.ai-loomhaus-header__menu-toggle-{{ ai_gen_id }}{display:none;color:inherit;background:transparent;border:0;padding:6px;cursor:pointer}.ai-loomhaus-header__menu-{{ ai_gen_id }}{display:none}
@media(max-width:749px){.ai-loomhaus-header__inner-{{ ai_gen_id }}{width:calc(100% - 28px);grid-template-columns:minmax(0,1fr) auto;gap:10px}.ai-loomhaus-header__tagline-{{ ai_gen_id }}{display:none}.ai-loomhaus-header__actions-{{ ai_gen_id }}{gap:9px}.ai-loomhaus-header__logo-{{ ai_gen_id }}{width:min({{ block.settings.logo_width }}px,34vw)}.ai-loomhaus-header__fallback-{{ ai_gen_id }}{font-size:20px}.ai-loomhaus-header__shop-{{ ai_gen_id }}{min-height:36px;padding:0 10px;font-size:9px;letter-spacing:.04em}.ai-loomhaus-header__menu-toggle-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-content:center}.ai-loomhaus-header__menu-{{ ai_gen_id }}[data-open=true]{display:block;width:calc(100% - 28px);margin:12px auto 0;padding-top:12px;border-top:1px solid currentColor}.ai-loomhaus-header__menu-{{ ai_gen_id }} ul{list-style:none;display:flex;flex-direction:column;gap:12px;padding:0;margin:0}.ai-loomhaus-header__menu-{{ ai_gen_id }} a{color:inherit;text-decoration:none}}
{% endstyle %}
<loomhaus-header-{{ ai_gen_id }} class="ai-loomhaus-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<div class="ai-loomhaus-header__inner-{{ ai_gen_id }}">
<a class="ai-loomhaus-header__brand-{{ ai_gen_id }}" href="{{ routes.root_url }}" aria-label="{{ block.settings.logo_fallback | escape }} home">{% if block.settings.logo_image != blank %}<img class="ai-loomhaus-header__logo-{{ ai_gen_id }}" src="{{ block.settings.logo_image | image_url: width: 600 }}" alt="{{ block.settings.logo_image.alt | default: block.settings.logo_fallback | escape }}" width="{{ block.settings.logo_image.width }}" height="{{ block.settings.logo_image.height }}">{% else %}<span class="ai-loomhaus-header__fallback-{{ ai_gen_id }}">{{ block.settings.logo_fallback | escape }}</span>{% endif %}</a>
{% if block.settings.show_tagline %}<p class="ai-loomhaus-header__tagline-{{ ai_gen_id }}">{{ block.settings.tagline | escape }}</p>{% else %}<span></span>{% endif %}
<div class="ai-loomhaus-header__actions-{{ ai_gen_id }}">{% if block.settings.show_shop_button and block.settings.button_url != blank %}<a class="ai-loomhaus-header__shop-{{ ai_gen_id }}" href="{{ block.settings.button_url }}">{{ block.settings.button_label | escape }}</a>{% endif %}<a class="ai-loomhaus-header__cart-{{ ai_gen_id }}" href="{{ routes.cart_url }}" aria-label="Shopping bag, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg><span class="ai-loomhaus-header__count-{{ ai_gen_id }}">{{ cart.item_count }}</span></a>{% if block.settings.mobile_menu != blank %}<button class="ai-loomhaus-header__menu-toggle-{{ ai_gen_id }}" type="button" aria-expanded="false" aria-controls="ai-loomhaus-menu-{{ ai_gen_id }}" aria-label="Open navigation menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>{% endif %}</div></div>
{% if block.settings.mobile_menu != blank %}<nav id="ai-loomhaus-menu-{{ ai_gen_id }}" class="ai-loomhaus-header__menu-{{ ai_gen_id }}" aria-label="Main navigation" data-open="false"><ul>{% for link in block.settings.mobile_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></nav>{% endif %}
<script>(function(){var tagName='loomhaus-header-{{ ai_gen_id }}';if(customElements.get(tagName))return;class LoomhausHeader extends HTMLElement{connectedCallback(){var button=this.querySelector('.ai-loomhaus-header__menu-toggle-{{ ai_gen_id }}');var menu=this.querySelector('.ai-loomhaus-header__menu-{{ ai_gen_id }}');if(!button||!menu)return;button.addEventListener('click',function(){var open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));button.setAttribute('aria-label',open?'Open navigation menu':'Close navigation menu');menu.setAttribute('data-open',String(!open));})}}customElements.define(tagName,LoomhausHeader)})();</script>
</loomhaus-header-{{ ai_gen_id }}>
{% schema %}
{"name":"Loomhaus Custom Header","settings":[{"type":"header","content":"Header content"},{"type":"image_picker","id":"logo_image","label":"Logo image"},{"type":"range","id":"logo_width","label":"Logo width","min":60,"max":300,"step":10,"unit":"px","default":160},{"type":"text","id":"logo_fallback","label":"Fallback text","default":"Loomhaus"},{"type":"checkbox","id":"show_tagline","label":"Show tagline","default":true},{"type":"text","id":"tagline","label":"Tagline","default":"Clothes made to be worn for years, not seasons."},{"type":"header","content":"Shop button"},{"type":"checkbox","id":"show_shop_button","label":"Show shop button","default":true},{"type":"text","id":"button_label","label":"Button label","default":"SHOP THE DROP"},{"type":"url","id":"button_url","label":"Button destination"},{"type":"header","content":"Mobile navigation"},{"type":"link_list","id":"mobile_menu","label":"Menu"},{"type":"header","content":"Colors and spacing"},{"type":"color","id":"background_color","label":"Background","default":"#F7F5ED"},{"type":"color","id":"text_color","label":"Text","default":"#292A26"},{"type":"color","id":"button_border_color","label":"Button border","default":"#292A26"},{"type":"range","id":"content_max_width","label":"Content max width","min":800,"max":1600,"step":50,"unit":"px","default":1300},{"type":"range","id":"horizontal_padding","label":"Horizontal padding","min":10,"max":60,"step":5,"unit":"px","default":25},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":8,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Loomhaus Custom Header"}],"tag":null,"class":"loomhaus-custom-header"}
{% endschema %}